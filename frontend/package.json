{
  "name": "2idiotz-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "start": "node build",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "api:generate": "sh scripts/api.sh",
    "api:check": "sh scripts/api.sh --check",
    "test:api": "tsx --test tests/api.test.ts",
    "dev:backend": "vite dev --host 0.0.0.0 --mode backend",
    "test:dev": "playwright test --config playwright.dev.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hey-api/openapi-ts": "latest",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.47.0",
    "@playwright/test": "^1.58.0",
    "@sveltejs/adapter-node": "^5.5.0",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "bits-ui": "^2.19.2",
    "cn": "^0.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "motion": "^13.4.0",
    "zod": "4.6.5"
  }
}
