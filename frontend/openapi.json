{
  "openapi": "3.1.0",
  "info": {
    "description": "API for managing public transport stops in Think different Academy.",
    "title": "Think different Transit API",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "tags": [
    {
      "description": "Stop management",
      "name": "Stops"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": ["health-controller"]
      }
    },
    "/stops": {
      "get": {
        "operationId": "getStops",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Stop"
                  }
                }
              }
            },
            "description": "List of stops"
          }
        },
        "summary": "List all stops",
        "tags": ["Stops"]
      },
      "post": {
        "operationId": "createStop",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stop"
                }
              }
            },
            "description": "Stop created successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid stop ID or input data"
          }
        },
        "summary": "Create a new stop",
        "tags": ["Stops"]
      }
    },
    "/stops/{id}": {
      "delete": {
        "operationId": "deleteStop",
        "parameters": [
          {
            "description": "Stop ID",
            "example": 12,
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Stop deleted successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid stop ID or input data"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Stop not found"
          }
        },
        "summary": "Delete a stop",
        "tags": ["Stops"]
      },
      "get": {
        "operationId": "getStop",
        "parameters": [
          {
            "description": "Stop ID",
            "example": 12,
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stop"
                }
              }
            },
            "description": "Stop detail"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid stop ID or input data"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Stop not found"
          }
        },
        "summary": "Get stop detail",
        "tags": ["Stops"]
      },
      "put": {
        "description": "Replaces the editable data of an existing stop. The complete StopInput object must be provided.",
        "operationId": "updateStop",
        "parameters": [
          {
            "description": "Stop ID",
            "example": 12,
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stop"
                }
              }
            },
            "description": "Stop updated successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid stop ID or input data"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Stop not found"
          }
        },
        "summary": "Update a stop",
        "tags": ["Stops"]
      }
    },
    "/team": {
      "get": {
        "operationId": "getTeam",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": ["team-controller"]
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string",
            "example": "Stop not found"
          }
        },
        "required": ["error"]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "required": ["status"]
      },
      "Stop": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "has_shelter": {
            "type": "boolean"
          },
          "has_ticket_machine": {
            "type": "boolean"
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "readOnly": true
          },
          "image_url": {
            "type": ["string", "null"],
            "format": "uri",
            "maxLength": 255
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1
          },
          "wheelchair_accessible": {
            "type": "boolean"
          }
        },
        "required": [
          "has_shelter",
          "has_ticket_machine",
          "id",
          "image_url",
          "name",
          "wheelchair_accessible"
        ]
      },
      "StopInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "has_shelter": {
            "type": "boolean"
          },
          "has_ticket_machine": {
            "type": "boolean"
          },
          "image_url": {
            "type": ["string", "null"],
            "format": "uri",
            "maxLength": 255,
            "minLength": 0
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1
          },
          "wheelchair_accessible": {
            "type": "boolean"
          }
        },
        "required": ["has_shelter", "has_ticket_machine", "name", "wheelchair_accessible"]
      },
      "TeamResponse": {
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["members", "name"]
      }
    }
  }
}
